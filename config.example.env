# deerflow-acp 配置模板
#
# 复制为 .env 或直接 export。桥自身不读 .env 文件，只读进程环境变量——
# 由启动方（Multica agent 配置、shell、systemd unit）注入。
#
# 秘密边界：桥不存储、不打印、不上传任何凭据。模型 API key 一律沿用
# DeerFlow 既有的本地注入机制（DeerFlow 的 conf.yaml / 其自身环境变量），
# 不要在这里配置任何 key。

# ---- DeerFlow 后端 ----

# DeerFlow 配置文件路径。留空时由 DeerFlowClient 走自身默认查找逻辑。
# DEERFLOW_ACP_CONFIG_PATH=/home/you/srv/deerflow/conf.yaml

# 覆盖 DeerFlow 默认模型名。留空 = 用 DeerFlow 配置里的默认值。
# DEERFLOW_ACP_MODEL=

# 是否开启思考模式（对应 ACP 的 thought 流）。true/1/yes 开启。
# DEERFLOW_ACP_THINKING=false

# ---- 生命周期 ----

# session/cancel 后等待工作线程收敛的宽限秒数。超时仍未退出时，
# turn 以 stopReason=cancelled 返回并在 stderr 记 escalated 警告。
# DEERFLOW_ACP_CANCEL_GRACE_SECONDS=5

# 收到 SIGINT/SIGTERM 后等待活跃 turn 收敛的宽限秒数，超时强制退出。
# DEERFLOW_ACP_SHUTDOWN_GRACE_SECONDS=5

# ---- 可选能力 ----

# 是否额外下发 ACP usage_update 通知。默认关闭：DeerFlow 只提供 token
# 增量，而 usage_update 要求 size（上下文窗口）与 used（当前占用），
# 语义无法无损映射。仅在同时设置 CONTEXT_WINDOW_TOKENS 时生效。
# DEERFLOW_ACP_EMIT_USAGE_UPDATE=false

# 目标模型的上下文窗口大小（token）。设置后 usage_update 才可能开启。
# DEERFLOW_ACP_CONTEXT_WINDOW_TOKENS=

# ---- 日志 ----

# 日志级别：DEBUG / INFO / WARNING / ERROR。日志一律只写 stderr，
# stdout 是 JSON-RPC 专用通道（fd 级隔离）。
# DEERFLOW_ACP_LOG_LEVEL=INFO

# ---- 测试用（仅开发者）----

# 开启与本机 DeerFlow 的真实 E2E（会产生真实模型调用与费用）。
# DEERFLOW_ACP_E2E=1
# DEERFLOW_ACP_E2E_TIMEOUT=300
